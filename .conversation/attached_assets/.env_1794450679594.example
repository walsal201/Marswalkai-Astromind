# Everything here is OPTIONAL. With no key the app runs in Demo mode instantly.
# In Replit, put these in the Secrets tool (never in the frontend).

# --- Pick ONE provider and set LLM_MODEL (any LiteLLM-style model string) ---
OPENAI_API_KEY=
# LLM_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=
# LLM_MODEL=anthropic/<model-name>

# GEMINI_API_KEY=
# LLM_MODEL=gemini/<model-name>

# IBM watsonx is still possible server-side if you want it:
# WATSONX_APIKEY=
# WATSONX_PROJECT_ID=
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# LLM_MODEL=watsonx/<model-id>

# --- App settings ---
RATE_LIMIT_PER_MIN=20
CORS_ORIGINS=*
